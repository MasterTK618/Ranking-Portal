# Copy these into your hosting provider's private environment settings.
PORT=3000
NODE_ENV=production
APP_URL=https://YOUR-BACKEND.onrender.com
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Roblox OAuth app credentials (separate from the Open Cloud API key)
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
ROBLOX_OAUTH_REDIRECT_URI=https://YOUR-BACKEND.onrender.com/auth/callback

# Roblox Open Cloud API key. NEVER commit the real value.
ROBLOX_API_KEY=
ROBLOX_GROUP_ID=16597698
MIN_RANK=245
