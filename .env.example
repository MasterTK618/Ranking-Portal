# Copy these into your hosting provider's private environment settings.
PORT=3000
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Roblox Open Cloud API key. NEVER commit the real value.
ROBLOX_API_KEY=
# Shared secret for Roblox game servers. Set a long random value privately in Render and the server Script.
INGAME_API_SECRET=
ROBLOX_GROUP_ID=16597698
MIN_RANK=245
